# ============================================================
# PostgreSQL Secret – Template
# ============================================================
# 1. Copy this file:   cp 01-secret.yaml.example 01-secret.yaml
# 2. Replace the base64 values below (see generation commands)
# 3. NEVER commit 01-secret.yaml to git (it is in .gitignore)
#
# Generate base64:
#   echo -n "your-value" | base64
#
# Decode to verify:
#   echo "dGVzdA==" | base64 -d
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: jobboard
  labels:
    app.kubernetes.io/name: postgres
type: Opaque
data:
  # "jobboard"
  POSTGRES_DB: am9iYm9hcmQ=
  # "postgres"
  POSTGRES_USER: cG9zdGdyZXM=
  # Replace with: echo -n "YourStr0ngP@ssword!" | base64
  POSTGRES_PASSWORD: REPLACE_WITH_BASE64_ENCODED_PASSWORD
